# 서버에서만 .env 로 복사해 값을 채운다(절대 커밋 금지).
DOMAIN=your-name.duckdns.org
DART_API_KEY=
DATA_GO_KR_KEY=
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 뉴스 탭(선택): 네이버 개발자센터 검색 API 키. 비우면 구글 뉴스로 대체됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KRX_AUTH_KEY=
# KRX 정보데이터시스템(data.krx.co.kr) 회원 아이디·비밀번호: ETF 구성종목·ETF 통계 과거 자료에 필요
KRX_ID=
KRX_PW=
APP_TOKEN=
MIN_SUPPORTED_VERSION=1.0.0
GITHUB_TOKEN=
